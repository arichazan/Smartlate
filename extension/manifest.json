{
  "manifest_version": 3,
  "name": "AI Translate & Rephrase - Phravexa",
  "short_name": "Phravexa",
  "version": "1.3.0",
  "description": "__MSG_extDescription__",
  "homepage_url": "https://arichazan.github.io/apps/phravexa.html",
  "default_locale": "en",
  "permissions": [
    "contextMenus",
    "storage",
    "scripting",
    "notifications",
    "activeTab",
    "offscreen",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "transform-selection": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "__MSG_commandDescription__"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
